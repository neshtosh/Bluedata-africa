{
  "name": "blue-ecosystem",
  "private": true,
  "description": "Digital infrastructure for Africa's fisheries and aquaculture economy — SamakiOS and BlueData Africa on one shared platform.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @blue/database db:migrate",
    "db:seed": "pnpm --filter @blue/database db:seed",
    "services:up": "docker compose -f infra/docker/docker-compose.yml up -d --wait",
    "services:down": "docker compose -f infra/docker/docker-compose.yml down",
    "services:reset": "docker compose -f infra/docker/docker-compose.yml down -v"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "devDependencies": {
    "pnpm": "10.34.9",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  }
}
