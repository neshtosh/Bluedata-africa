**/dist
**/.next
**/.next-e2e
**/.turbo
**/coverage
**/*.tsbuildinfo
.git
.env
.env.*
!.env.example
tests/e2e/.artifacts
tests/e2e/playwright-report
tests/e2e/test-results
.claude
