# Copy to .env for local development. Never commit .env.
# Values here are local-only defaults; staging/production secrets come from the cloud secrets manager.

# --- Local services (infra/docker/docker-compose.yml) ---
POSTGRES_DB=blue
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
APP_MIGRATOR_PASSWORD=migrator_dev
APP_RUNTIME_PASSWORD=runtime_dev
VALKEY_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- API and worker (validated at startup: apps/api/src/kernel/config/app-config.ts) ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_POOL_SIZE=10
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
# Local-only value. Generate a real one per environment: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=local-development-secret-change-me-0123456789
SMS_PROVIDER=log
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
TRUST_PROXY=false

# --- Application connection strings ---
DATABASE_MIGRATOR_URL=postgres://app_migrator:migrator_dev@localhost:5432/blue
DATABASE_RUNTIME_URL=postgres://app_runtime:runtime_dev@localhost:5432/blue
VALKEY_URL=redis://localhost:6379
SMTP_URL=smtp://localhost:1025
